---
title: 图2 恢复旧会话（-c）vs 新建会话（/new）对照流程图
---
flowchart TD
    S(["A 阶段已结束：Pi 已读到并回答了启动命令"]) --> D{"用户接下来怎么做？"}

    D -->|"左侧：保留历史"| L1
    D -->|"右侧：清空历史"| R1

    subgraph LEFT["左分支：恢复旧会话（-c）—— 历史消息从会话文件回到上下文"]
        direction TB
        L1["退出 Pi"] --> L2["加 -c 重新启动：<br/>node .\packages\coding-agent\dist\cli.js -c"]
        L2 --> L3["Pi 打开 A 阶段保存的会话文件"]
        L3 --> L4["从文件恢复历史消息"]
        L4 --> L5["用户输入：<br/>「接着上次的待办，给 README 起草一条启动说明…」"]
        L5 --> L6["恢复出的历史消息 + 本次提问<br/>一起发给模型"]
        L6 --> L7["模型答出完整启动命令<br/>npm run demo -- --profile river-731"]
        L7 --> L8["未重新读文件：本次没有发生任何工具调用"]
        L8 --> LR["实测：回复包含「npm run demo -- --profile river-731」；<br/>[P4] 日志只有 1 条「[P4] Agent 即将请求模型」；未调用工具"]
    end

    subgraph RIGHT["右分支：新建会话（/new）—— 新会话历史为空"]
        direction TB
        R1["输入 /new"] --> R2["创建聊天历史为空的新会话"]
        R2 --> R3["用户输入完全相同的提问：<br/>「接着上次的待办，给 README 起草一条启动说明…」"]
        R3 --> R4["仅本次提问发给模型：<br/>新会话历史中没有 A 阶段读到的启动命令"]
        R4 --> R5["模型回答缺少命令"]
        R5 --> RR["实测（全新会话 --no-session）：回复「我无法完成这个任务，<br/>因为本会话中并不存在“上次的待办”或“交接单”的内容」；<br/>[P4] 日志 1 条；未调用工具"]
    end

    LR --> CMP{"对照结论"}
    RR --> CMP
    CMP --> C1["上下文差异：<br/>恢复会话 = 历史消息 + 本次提问；新建会话 = 仅本次提问"]
    C1 --> C2["行为差异：<br/>恢复会话能直接答出启动命令，新建会话答不出"]
    C2 --> C3["原因：模型只能看见上下文里真实存在的消息，<br/>上下文里没有的东西它无法凭空回忆"]

    subgraph NOTE["会话与上下文的关系"]
        direction TB
        N1["会话文件（磁盘）：保存历史消息，是持久化载体"]
        N2["聊天历史 / 上下文（内存）：模型实际看到的 messages 数组"]
        N3["-c 恢复 = 把磁盘上的历史消息重新装进 messages 数组"]
        N4["/new 新建 = 换一个空的 messages 数组，会话文件另起一份"]
        N1 --> N2
        N3 --> N2
        N4 --> N2
    end

    C3 --> N1
    N2 --> Z(["结论：会话恢复的本质是把历史消息放回上下文"])
